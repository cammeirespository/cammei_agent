{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "trustedProxies": [
      "100.64.0.0/10"
    ],
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },

  "models": {
    "providers": {
      "groq": {
        "baseUrl": "https://api.groq.com/openai/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "GROQ_API_KEY"
        },
        "models": [
          {
            "id": "openai/gpt-oss-120b",
            "name": "GPT OSS 120B"
          },
          {
            "id": "openai/gpt-oss-20b",
            "name": "GPT OSS 20B"
          },
          {
            "id": "qwen/qwen3.8-27b",
            "name": "Qwen 3.8 27B"
          }
        ]
      }
    }
  },

  "plugins": {
    "entries": {
      "browser": {
        "enabled": false
      },
      "canvas": {
        "enabled": false
      },
      "cua-computer": {
        "enabled": false
      },
      "ollama": {
        "enabled": false
      },
      "geolocation": {
        "enabled": false
      },
      "talk-voice": {
        "enabled": false
      },
      "anthropic": {
        "enabled": false
      },
      "openai": {
        "enabled": false
      },
      "xai": {
        "enabled": false
      },
      "file-transfer": {
        "enabled": false
      },
      "device-pair": {
        "enabled": false
      },
      "linux-node": {
        "enabled": false
      },
      "memory-core": {
        "enabled": false
      },
      "github": {
        "enabled": true
      },
      "groq": {
        "enabled": true
      }
    }
  },

  "skills": {
    "entries": {}
  },

  "tools": {
    "web": {
      "fetch": {
        "headers": {
          "Authorization": "Bearer ${GITHUB_TOKEN}"
        }
      }
    }
  },

  "agents": {
    "entries": {
      "main": {
        "default": true,
        "name": "Cammei Assistant",
        "workspace": "~/.openclaw/workspace-main",
        "model": "groq/openai/gpt-oss-120b",
        "skills": [],
        "tools": {
          "allow": [
            "read",
            "sessions_spawn",
            "sessions_send",
            "sessions_list",
            "session_status"
          ]
        }
      },

      "architect": {
        "name": "Cammei Architect",
        "workspace": "~/.openclaw/workspace-architect",
        "model": "groq/openai/gpt-oss-120b",
        "skills": [],
        "tools": {
          "allow": [
            "read"
          ]
        }
      },

      "github": {
        "name": "Cammei GitHub Liaison",
        "workspace": "~/.openclaw/workspace-github",
        "model": "groq/openai/gpt-oss-20b",
        "skills": [],
        "tools": {
          "allow": [
            "read",
            "web_fetch"
          ]
        }
      }
    }
  }
}
