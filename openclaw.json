{
  "gateway": {
    "bind": "loopback",
    "auth": {
      "mode": "token"
    }
  },

  "models": {
    "providers": {
      "google": {
        "apiKey": { "source": "env", "provider": "default", "id": "GEMINI_API_KEY" }
      },
      "groq": {
        "baseUrl": "https://api.groq.com/openai/v1",
        "apiKey": { "source": "env", "provider": "default", "id": "GROQ_API_KEY" },
        "models": [
          { "id": "llama-3.3-70b-versatile" },
          { "id": "qwen-2.5-coder-32b" }
        ]
      }
    }
  },

  "skills": {
    "entries": {
      "github": {
        "apiKey": { "source": "env", "provider": "default", "id": "GITHUB_TOKEN" },
        "env": {
          "GITHUB_REPO": { "source": "env", "provider": "default", "id": "GITHUB_REPO" }
        }
      }
    }
  },

  "agents": {
    "ownership": "explicit",
    "entries": {
      "main": {
        "default": true,
        "name": "Cammei Assistant",
        "workspace": "~/.openclaw/workspace-main",
        "model": "groq/llama-3.3-70b-versatile",
        "skills": [],
        "tools": {
          "allow": ["read", "sessions_spawn", "sessions_send", "sessions_list", "session_status"]
        }
      },

      "architect": {
        "name": "Cammei Architect",
        "workspace": "~/.openclaw/workspace-architect",
        "model": "groq/llama-3.3-70b-versatile",
        "skills": [],
        "tools": {
          "allow": ["read"],
          "deny": ["exec", "write", "edit", "apply_patch", "browser"]
        }
      },

      "coder": {
        "name": "Cammei Coder",
        "workspace": "~/.openclaw/workspace-coder",
        "model": "groq/qwen-2.5-coder-32b",
        "skills": [],
        "sandbox": {
          "mode": "all",
          "scope": "agent"
        },
        "tools": {
          "allow": ["read", "write", "edit", "exec"]
        }
      },

      "github": {
        "name": "Cammei GitHub Liaison",
        "workspace": "~/.openclaw/workspace-github",
        "model": "groq/llama-3.3-70b-versatile",
        "skills": ["github"],
        "tools": {
          "allow": ["read"],
          "deny": ["exec", "write", "edit", "apply_patch"]
        }
      }
    }
  }
}
